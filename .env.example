# Comma-separated browser origins allowed to call the API.
ED05_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:5500

# Pretrained English sentence embedding model used for semantic retrieval.
ED05_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Add the supplemental OpenStax corpus to searches only when desired.
ED05_INCLUDE_OPENSTAX=false

# Optional OCR executable override; the Windows installer default is auto-detected.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
